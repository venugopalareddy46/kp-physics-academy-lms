# SQLite
SQLITE_PATH=./data/kp-physics.sqlite

# Application
APP_URL=https://venugopalareddy.in
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_NAME=kp_session

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=kp-lms-media
R2_PUBLIC_BASE_URL=https://media.venugopalareddy.in

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx

# Optional CORS origin for FlutterFlow
FLUTTERFLOW_ORIGIN=https://app.venugopalareddy.in
